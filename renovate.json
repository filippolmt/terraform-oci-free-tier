{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Group all OpenTofu provider updates",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "opentofu providers",
      "automerge": false
    },
    {
      "description": "Group all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the OpenTofu version used by the CI workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/terraform\\.yml$/"
      ],
      "matchStrings": [
        "OPENTOFU_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "opentofu/opentofu",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
