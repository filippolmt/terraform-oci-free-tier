# Copy this file to terraform.tfvars and fill in the values.
# All values are available in the OCI Console: https://cloud.oracle.com

# --- Authentication method ----------------------------------------------------
# Choose how the OCI provider authenticates. Default is "ApiKey".
#
#   ApiKey        → use an uploaded API signing key (fill the API key fields below).
#   SecurityToken → use a CLI session token created by `oci session authenticate`
#                   (browser login). With this method the API key fields
#                   (oracle_api_key_fingerprint, user_ocid, tenancy_ocid,
#                   oracle_api_private_key_path) can be left empty — they are read
#                   from the session profile in ~/.oci/config.
#
# auth_method         = "ApiKey"
# config_file_profile = "DEFAULT"   # profile in ~/.oci/config (the one created by `oci session authenticate`)

# --- API key fields (required only for auth_method = "ApiKey") -----------------

# API key fingerprint — OCI Console → Profile → API Keys → Fingerprint column
# Format: aa:bb:cc:dd:...
oracle_api_key_fingerprint = ""

# User OCID — OCI Console → Profile → My profile → OCID (copy)
# Format: ocid1.user.oc1..aaaaaa...
user_ocid = ""

# Tenancy OCID — OCI Console → Profile → Tenancy → OCID (copy)
# Format: ocid1.tenancy.oc1..aaaaaa...
tenancy_ocid = ""

# Compartment OCID — OCI Console → Identity → Compartments → select compartment → OCID (copy)
# Use root compartment OCID (same as tenancy) for Free Tier
# Format: ocid1.compartment.oc1..aaaaaa... (or ocid1.tenancy.oc1..aaaaaa...)
compartment_ocid = ""

# SSH public key — paste the full contents of your ~/.ssh/id_rsa.pub (or id_ed25519.pub)
# Format: ssh-rsa AAAAB3... user@host  or  ssh-ed25519 AAAAC3... user@host
ssh_public_key = ""

# Region — must be your tenancy home region. OCI Console → the region menu in the
# top bar shows it as "Home region". Always Free resources built anywhere else are
# billed at full price, so the module refuses unless you acknowledge it below.
# Format: eu-milan-1, us-ashburn-1, ...
region = ""

# --- Optional -----------------------------------------------------------------
# The defaults below are the Always Free caps. They are the single source of
# truth; uncomment a line only to deviate from it deliberately.

# Timezone — IANA timezone for the instance
# timezone = "Europe/Rome"

# Instance sizing — the Always Free cap is 2 OCPUs and 12 GB of memory.
# Anything above requires acknowledge_billable_resources = true.
# instance_shape_config_ocpus     = 2
# instance_shape_config_memory_gb = 12

# Block storage — Always Free covers 200 GB total across the boot volume
# (instance_shape_boot_volume_size_gb, 50 GB by default) and this one.
# docker_volume_size_gb = 150

# Set to true to provision resources outside the Always Free allocation:
# compute above 2 OCPUs / 12 GB, more than 200 GB of storage, or a region other
# than your home region. On a Pay-As-You-Go account these are billed.
# acknowledge_billable_resources = false
